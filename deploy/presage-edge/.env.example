# Deployment environment for the presage-edge Compose project on root@dev.
# Copy to `.env` on the deployment host only (never commit the real file):
#   cp .env.example .env   # then fill in SMARTSPECTRA_API_KEY
#
# Variable names must match presage-api/src/config.ts. Note: the deployment
# plan doc lists SMARTSPECTRA_TELEMETRY_ENABLED / LOG_LEVEL / MAX_WS_FRAME_BYTES,
# but the code reads SMARTSPECTRA_ENABLE_TELEMETRY / SMARTSPECTRA_LOG_LEVEL /
# MAX_FRAME_BYTES -- the names below are the ones the API actually honors.

SMARTSPECTRA_API_KEY=replace-with-rotated-presage-key

SMARTSPECTRA_ENABLE_TELEMETRY=false
SMARTSPECTRA_LOG_LEVEL=warning

# 1 GiB maximum multipart video upload.
MAX_VIDEO_BYTES=1073741824
# 6-hour ceiling for long-form video analysis.
VIDEO_ANALYSIS_TIMEOUT_MS=21600000
# 16 MiB maximum WebSocket frame payload, including the 8-byte timestamp.
MAX_FRAME_BYTES=16777216

# R2 bucket holding prerecorded clips for POST /v1/videos/analyze-r2.
# Copy the same values as the web app's R2_* settings. Omit all four to
# disable the endpoint (it returns 503). R2_KEY_PREFIX=interviews/ is
# recommended so clients can only request interview clips.
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=
#R2_KEY_PREFIX=interviews/
