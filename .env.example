# Root compose env (docker-compose.yml loads this as .env for all services).
# Copy to .env and fill in: cp .env.example .env
# app/ reads the NEXT_*/CLERK/DATABASE/R2/GEMINI/ELEVENLABS/DEEPGRAM/PRESAGE vars;
# presage-api/ reads SMARTSPECTRA_*/HOST/PORT/MAX_*; certbot reads CERTBOT_EMAIL/DOMAIN.

# Domain (nginx server_name + certbot). Defaults to getmehired.today if unset.
DOMAIN=getmehired.today
CERTBOT_EMAIL=

# Clerk (https://dashboard.clerk.com/~/api-keys) — bake publishable key at build time
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
CLERK_SECRET_KEY=

# Postgres (TigerData/Timescale) — migrations in app/migrations/0001-0011 must be
# applied by hand before first boot: psql "$DATABASE_URL" -f app/migrations/<file>.sql
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# Cloudflare R2 (durable clips) — bucket needs CORS for PUT/GET from app origin.
# Run once: pnpm --dir app setup:r2-cors
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Interview AI
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_REPORT_MODEL=
PRACTICE_AGENT_ENABLED=true
BACKBOARD_API_KEY=
GET_ME_HIRED_RESEARCH_DIR=
GET_ME_HIRED_RESEARCH_SOURCE=local
GET_ME_HIRED_RESEARCH_VERSION=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
DEEPGRAM_API_KEY=

# presage-api — internal service, never called from the browser.
# In compose, app reaches it at http://presage-api:8080; locally use http://localhost:8080.
PRESAGE_API_URL=http://presage-api:8080
SMARTSPECTRA_API_KEY=replace-with-your-api-key
SMARTSPECTRA_ENABLE_TELEMETRY=false
SMARTSPECTRA_LOG_LEVEL=warning
MAX_VIDEO_BYTES=1073741824
VIDEO_ANALYSIS_TIMEOUT_MS=21600000
MAX_FRAME_BYTES=16777216
HOST=0.0.0.0
PORT=8080
