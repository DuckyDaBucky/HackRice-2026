NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Clerk (https://dashboard.clerk.com/~/api-keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# TigerData (TimescaleDB) — tiger service get <service-id> --output env --with-password
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=no-verify

# Gemini (LLM of choise)
GEMINI_API_KEY=

# ElevenLabs (interviewer voice) — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional: defaults to the premade "Rachel" voice if unset
ELEVENLABS_VOICE_ID=