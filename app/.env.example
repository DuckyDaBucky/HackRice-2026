NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Clerk (https://dashboard.clerk.com/~/api-keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# TigerData (TimescaleDB) — tiger service get <service-id> --output env --with-password
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=no-verify

# Cloudflare R2 (durable video storage for recorded answers) — S3-compatible API,
# create an API token under R2 > Manage API Tokens in the Cloudflare dashboard.
# The bucket needs a CORS policy allowing PUT/GET from this app's origin(s).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# LLM provider — modular. "meta" (Muse Spark via Meta Model API, default when
# MODEL_API_KEY is set) or "gemini" (legacy Google path). Unset auto-selects:
# MODEL_API_KEY present -> meta, otherwise gemini.
# Muse Spark (https://dev.meta.ai) — OpenAI-compatible, key as bearer token.
LLM_PROVIDER=
MODEL_API_KEY=
# Optional: defaults to muse-spark-1.3-contributor
MIRA_MODEL=
# Optional: defaults to https://api.meta.ai/v1
MIRA_BASE_URL=

# Local-only /dev workbench; the dataset must remain outside the repository.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GET_ME_HIRED_RESEARCH_DIR=

# Backboard: approved practice notes only; never expose this key to the browser
BACKBOARD_API_KEY=

# Reference corpus source: local (default) or database
GET_ME_HIRED_RESEARCH_SOURCE=local
GET_ME_HIRED_RESEARCH_VERSION=
# Gemini for the interview follow-up route (separate from GOOGLE_API_KEY above)
GEMINI_API_KEY=
# Optional model for post-interview reports; defaults to GEMINI_MODEL
GEMINI_REPORT_MODEL=
# Interview agent kill-switch: set to "false" to force planned-only questions
PRACTICE_AGENT_ENABLED=true

# LLM provider — modular. "meta" (Muse Spark via Meta Model API, default when
# MODEL_API_KEY is set) or "gemini" (legacy Google path). Unset auto-selects:
# MODEL_API_KEY present -> meta, otherwise gemini.
# Muse Spark (https://dev.meta.ai) — OpenAI-compatible, key as bearer token.
LLM_PROVIDER=
MODEL_API_KEY=
# Optional: defaults to muse-spark-1.3-contributor
MIRA_MODEL=
# Optional: defaults to https://api.meta.ai/v1
MIRA_BASE_URL=

# ElevenLabs (interviewer voice) — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional: defaults to the premade "Rachel" voice if unset
ELEVENLABS_VOICE_ID=

# presage-api (biometric readout, opt-in per session) — internal service, never call
# this from the browser. Defaults to the docker-compose service hostname.
# For local `pnpm dev` outside compose, override with http://localhost:8080.
PRESAGE_API_URL=http://presage-api:8080

# Transcription (batch correction for recorded answers) — Deepgram preferred,
# Gemini audio fallback. Live captions stay browser-local; only the recorded
# blob is sent to these providers after each answer.
# Deepgram (https://console.deepgram.com/) — nova-3 with smart_format
DEEPGRAM_API_KEY=

# --- Hiring flow — disabled until migrations + providers verified ---
HIRING_ENABLED=false
HIRING_WORKER_SECRET=
# Comma-separated emails with full HR access (admin) without Clerk org membership
HIRING_SUPERADMIN_EMAILS=

# Persona sandbox/production (HR invitees only)
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
PERSONA_WEBHOOK_SECRET=
PERSONA_ENV=sandbox
# Local/demo only. Confirms the recruiter-bound Clerk email without Persona. Ignored when PERSONA_ENV=production.
PERSONA_SANDBOX_BYPASS=false

# Solana devnet (app-sponsored; candidates need no wallet)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=
SOLANA_SERVICE_KEYPAIR=
SOLANA_VERIFIER_KEYPAIR=
SOLANA_DRY_RUN=true
