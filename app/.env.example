NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Clerk (https://dashboard.clerk.com/~/api-keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# TigerData (TimescaleDB) — tiger service get <service-id> --output env --with-password
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=no-verify

# Cloudflare R2 (durable video storage for recorded answers) — S3-compatible API,
# create an API token under R2 > Manage API Tokens in the Cloudflare dashboard.
# The bucket needs a CORS policy allowing PUT/GET from this app's origin(s).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Local-only /dev workbench; the dataset must remain outside the repository.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GET_ME_HIRED_RESEARCH_DIR=

# Backboard: approved practice notes only; never expose this key to the browser
BACKBOARD_API_KEY=

# Reference corpus source: local (default) or database
GET_ME_HIRED_RESEARCH_SOURCE=local
GET_ME_HIRED_RESEARCH_VERSION=
# Gemini for the interview follow-up route (separate from GOOGLE_API_KEY above)
GEMINI_API_KEY=
# Optional model for post-interview reports; defaults to GEMINI_MODEL
GEMINI_REPORT_MODEL=

# ElevenLabs (interviewer voice) — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional: defaults to the premade "Rachel" voice if unset
ELEVENLABS_VOICE_ID=

# presage-api (biometric readout, opt-in per session) — internal service, never call
# this from the browser. Defaults to the docker-compose service hostname.
PRESAGE_API_URL=http://presage-api:8080

# Transcription (batch correction for recorded answers) — Deepgram preferred,
# Gemini audio fallback. Live captions stay browser-local; only the recorded
# blob is sent to these providers after each answer.
# Deepgram (https://console.deepgram.com/) — nova-3 with smart_format
DEEPGRAM_API_KEY=

