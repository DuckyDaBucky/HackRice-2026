{
  "name": "presage-api",
  "version": "0.1.0",
  "private": true,
  "description": "Language-agnostic HTTP and WebSocket wrapper for the SmartSpectra Node SDK",
  "type": "module",
  "engines": { "node": ">=20.12.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "openapi:lint": "npx --yes @redocly/cli@latest lint openapi.yaml"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.1",
    "@fastify/websocket": "11.3.0",
    "@smartspectra/node-sdk": "3.3.0",
    "fastify": "5.12.4",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
