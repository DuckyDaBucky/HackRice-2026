SMARTSPECTRA_API_KEY=replace-with-your-api-key

HOST=0.0.0.0
PORT=8080
SMARTSPECTRA_ENABLE_TELEMETRY=false
SMARTSPECTRA_LOG_LEVEL=warning

# 1 GiB maximum multipart video upload.
MAX_VIDEO_BYTES=1073741824
# 6-hour ceiling for long-form video analysis.
VIDEO_ANALYSIS_TIMEOUT_MS=21600000
# 16 MiB maximum WebSocket frame payload, including the 8-byte timestamp.
MAX_FRAME_BYTES=16777216

# R2 bucket holding prerecorded clips for POST /v1/videos/analyze-r2.
# Optional as a group: omit all four to disable the endpoint (it returns 503).
# R2_KEY_PREFIX optionally restricts requestable keys (recommended: interviews/).
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=
#R2_KEY_PREFIX=interviews/
